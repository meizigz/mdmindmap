              "text": "糖酵解",
              "children": [
                {
                  "line": 8,
                  "text": "产物：2个丙酮酸、2 ATP、2 NADH"
                }
              ]
            }
          },
          {
            "from": 3,
            "to": 5,
            "node": {
              "line": 12,
              "text": "柠檬酸循环（三羧酸循环）",
              "children": [
                {
                  "line": 13,
                  "text": "产物：4 ATP、2 $\\ce{CO2}$、8 NADH、2 FADH2"
                }
              ]
            }
          }
        ]
      },
