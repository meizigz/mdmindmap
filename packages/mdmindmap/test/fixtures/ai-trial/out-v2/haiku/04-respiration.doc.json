    "text": "细胞呼吸",
    "children": [
      {
        "line": 3,
        "text": "有氧呼吸",
        "id": "aerobic",
        "children": [
          {
            "line": 4,
            "text": "第一阶段：细胞质基质"
          },
          {
            "line": 5,
            "text": "葡萄糖（6碳）分解为丙酮酸（3碳）"
          },
          {
            "line": 6,
            "text": "释放部分能量，产生少量ATP"
          },
          {
            "line": 9,
            "text": "第二阶段：线粒体基质"
          },
          {
            "line": 10,
            "text": "丙酮酸进入线粒体完全氧化"
          },
          {
            "line": 11,
            "text": "产生 $\\ce{CO2}$"
          },
          {
            "line": 14,
            "text": "第三阶段：线粒体内膜",
            "children": [
              {
                "line": 15,
                "text": "电子传递链，大量产生ATP"
              },
              {
                "line": 16,
                "text": "NADH 和 FADH2 被氧化"
              },
              {
                "line": 17,
                "text": "产物：约32 ATP"
              }
            ]
          },
          {
            "line": 18,
            "text": "总反应：$\\ce{C6H12O6 + 6O2 -> 6CO2 + 6H2O + 能量}$"
          }
        ],
        "summaries": [
