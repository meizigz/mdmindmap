            "text": "东亚季风",
            "children": [
              {
                "line": 35,
                "text": "冬季：冷高压南下，吹东北风"
              },
              {
                "line": 36,
                "text": "夏季：低气压，吹西南风"
              }
            ]
          },
          {
            "line": 37,
            "text": "南亚季风",
            "children": [
              {
                "line": 38,
                "text": "冬季：受信风影响，吹东北风"
              },
              {
                "line": 39,
                "text": "夏季：吹西南季风，降水丰富"
              }
            ]
          },
          {
            "line": 40,
            "text": "成因：陆地与海洋的热力差异",
            "children": [
              {
                "line": 41,
                "text": "陆地升温快降温快，海洋升温慢降温慢"
              }
            ]
          }
        ]
      },
