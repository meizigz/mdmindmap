            "line": 53,
            "text": "大陆性气候",
            "children": [
              {
                "line": 54,
                "text": "内陆远离海洋：温度年较差大"
              },
              {
                "line": 55,
                "text": "例：中亚地区"
              }
            ]
          },
          {
            "line": 56,
