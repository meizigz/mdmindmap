        "id": "self-ind",
        "children": [
          {
            "line": 18,
            "text": "定义：线圈中电流变化引起的感应现象"
          },
          {
            "line": 19,
            "text": "自感系数（电感） $L = \\frac{\\Phi}{I}$",
            "id": "self-coef"
          },
          {
            "line": 20,
            "text": "应用：日光灯启动、开关电源"
          },
          {
