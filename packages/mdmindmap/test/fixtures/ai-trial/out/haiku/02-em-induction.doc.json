    "children": [
      {
        "line": 3,
        "text": "法拉第电磁感应定律",
        "id": "faraday",
        "color": "red",
        "children": [
          {
            "line": 4,
            "text": "内容：磁通量变化产生感应电动势"
          },
          {
            "line": 5,
            "text": "$\\varepsilon = -\\frac{\\Delta \\Phi}{\\Delta t}$"
          },
          {
            "line": 6,
            "text": "条件：磁通量必须改变"
          },
          {
            "line": 7,
            "text": "应用：变压器、发电机原理"
          }
        ]
      },
      {
        "line": 8,
        "text": "楞次定律",
        "id": "lenz",
        "color": "red",
        "fold": true,
        "children": [
          {
            "line": 9,
            "text": "方向：感应电流阻碍原因磁通量的变化"
          },
          {
            "line": 10,
            "text": "磁通量增加时"
          },
          {
            "line": 11,
            "text": "感应电流产生的磁场方向与原磁场相反"
          },
          {
            "line": 13,
            "text": "磁通量减少时"
          },
          {
            "line": 14,
            "text": "感应电流产生的磁场与原磁场同向"
          },
          {
            "line": 16,
            "text": "易错：不要混淆\"阻碍变化\"和\"阻碍磁通量\""
          }
        ],
