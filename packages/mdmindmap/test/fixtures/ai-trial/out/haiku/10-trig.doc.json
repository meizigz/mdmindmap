              },
              {
                "line": 134,
                "text": "$\\cos \\alpha \\sin \\beta = \\frac{1}{2}[\\sin(\\alpha + \\beta) - \\sin(\\alpha - \\beta)]$"
              },
              {
                "line": 135,
                "text": "$\\cos \\alpha \\cos \\beta = \\frac{1}{2}[\\cos(\\alpha + \\beta) + \\cos(\\alpha - \\beta)]$"
