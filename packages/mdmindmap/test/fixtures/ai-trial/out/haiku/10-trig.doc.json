            "line": 121,
            "text": "二倍角公式",
            "children": [
              {
                "line": 122,
                "text": "$\\sin 2\\alpha = 2\\sin \\alpha \\cos \\alpha$"
              },
              {
                "line": 123,
                "text": "$\\cos 2\\alpha = \\cos^2 \\alpha - \\sin^2 \\alpha = 2\\cos^2 \\alpha - 1 = 1 - 2\\sin^2 \\alpha$"
              },
              {
                "line": 124,
                "text": "$\\tan 2\\alpha = \\frac{2\\tan \\alpha}{1 - \\tan^2 \\alpha}$"
              },
              {
                "line": 126,
                "text": "降幂：$\\cos^2 \\alpha = \\frac{1 + \\cos 2\\alpha}{2}$，$\\sin^2 \\alpha = \\frac{1 - \\cos 2\\alpha}{2}$"
              }
            ],
            "summaries": [
              {
                "from": 0,
                "to": 2,
                "node": {
                  "line": 125,
                  "text": "倍角公式"
