          {
            "line": 127,
            "text": "半角公式",
            "children": [
              {
                "line": 128,
                "text": "$\\sin \\frac{\\alpha}{2} = \\pm\\sqrt{\\frac{1 - \\cos \\alpha}{2}}$"
              },
              {
                "line": 129,
                "text": "$\\cos \\frac{\\alpha}{2} = \\pm\\sqrt{\\frac{1 + \\cos \\alpha}{2}}$"
              },
              {
                "line": 130,
                "text": "$\\tan \\frac{\\alpha}{2} = \\pm\\sqrt{\\frac{1 - \\cos \\alpha}{1 + \\cos \\alpha}} = \\frac{\\sin \\alpha}{1 + \\cos \\alpha}$"
              }
            ],
            "summaries": [
              {
                "from": 0,
                "to": 2,
                "node": {
                  "line": 131,
                  "text": "半角公式"
