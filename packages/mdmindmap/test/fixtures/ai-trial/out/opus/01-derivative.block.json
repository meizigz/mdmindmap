          "id": "deriv",
          "children": [
            {
              "line": 4,
              "text": "定义：$f'(x_0)=\\lim\\limits_{\\Delta x\\to 0}\\frac{\\Delta y}{\\Delta x}$"
            },
            {
              "line": 5,
              "text": "几何意义：切线斜率 $k=f'(x_0)$"
            },
            {
              "line": 6,
              "text": "切线方程 $y-f(x_0)=f'(x_0)(x-x_0)$"
            },
            {
              "line": 7,
              "text": "常用求导公式",
              "fold": true,
              "children": [
                {
                  "line": 8,
                  "text": "$(x^n)'=nx^{n-1}$"
                },
                {
                  "line": 9,
                  "text": "$(e^x)'=e^x$，$(a^x)'=a^x\\ln a$"
                },
                {
                  "line": 10,
                  "text": "$(\\ln x)'=\\frac{1}{x}$"
                },
                {
                  "line": 11,
                  "text": "$(\\sin x)'=\\cos x$，$(\\cos x)'=-\\sin x$"
                }
              ]
            },
            {
              "line": 12,
              "text": "运算法则",
              "fold": true,
              "children": [
                {
                  "line": 13,
                  "text": "$(u\\pm v)'=u'\\pm v'$"
                },
                {
                  "line": 14,
                  "text": "$(uv)'=u'v+uv'$"
                },
                {
                  "line": 15,
                  "text": "$\\left(\\frac{u}{v}\\right)'=\\frac{u'v-uv'}{v^2}$"
                },
                {
                  "line": 16,
                  "text": "复合函数 $y'_x=y'_u\\cdot u'_x$"
                }
              ]
            }
          ]
