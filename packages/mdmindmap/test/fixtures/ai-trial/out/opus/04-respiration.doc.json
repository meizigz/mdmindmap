{
  "root": {
    "line": 1,
    "text": "细胞呼吸",
    "children": [
      {
        "line": 3,
        "text": "概念：有机物氧化分解，释放能量，生成 ATP"
      },
      {
        "line": 4,
        "text": "有氧呼吸",
        "id": "aerobic",
        "color": "green",
        "children": [
          {
            "line": 5,
            "text": "第一阶段：细胞质基质",
            "id": "stage1",
            "children": [
              {
                "line": 6,
                "text": "葡萄糖 → 2 丙酮酸 + 少量 [H]"
              },
              {
                "line": 7,
                "text": "释放少量能量"
              }
            ]
          },
          {
            "line": 8,
            "text": "第二阶段：线粒体基质",
            "children": [
              {
                "line": 9,
                "text": "丙酮酸 + $\\ce{H2O}$ → $\\ce{CO2}$ + [H]"
              },
              {
                "line": 10,
                "text": "释放少量能量"
              }
            ]
          },
          {
            "line": 11,
            "text": "第三阶段：线粒体内膜",
            "color": "red",
            "children": [
              {
                "line": 12,
                "text": "[H] + $\\ce{O2}$ → $\\ce{H2O}$"
              },
              {
                "line": 13,
                "text": "释放**大量**能量"
              }
            ]
          },
          {
            "line": 18,
            "text": "总反应式：$\\ce{C6H12O6 + 6H2O + 6O2 ->[酶] 6CO2 + 12H2O + 能量}$"
          },
          {
            "line": 19,
            "text": "$\\ce{O2}$ 中的 O 进入 $\\ce{H2O}$",
            "color": "orange"
          },
          {
            "line": 20,
            "text": "1 mol 葡萄糖释放 2870 kJ，约 1161 kJ 储存在 ATP 中"
          }
        ],
        "summaries": [
          {
            "from": 0,
            "to": 2,
            "node": {
              "line": 14,
              "text": "三个阶段的共同点",
              "children": [
                {
                  "line": 15,
                  "text": "每阶段都需要酶催化"
                },
                {
                  "line": 16,
                  "text": "每阶段都释放能量、产生 ATP"
                },
                {
                  "line": 17,
                  "text": "只有第三阶段需要 $\\ce{O2}$",
                  "color": "red"
                }
              ]
            }
          }
        ]
      },
      {
        "line": 21,
        "text": "无氧呼吸",
        "id": "anaerobic",
        "children": [
          {
            "line": 22,
            "text": "场所：全部在细胞质基质"
          },
          {
            "line": 23,
            "text": "第一阶段与有氧呼吸相同",
            "id": "same"
          },
          {
            "line": 24,
            "text": "第二阶段不释放能量",
            "color": "red"
          },
          {
            "line": 25,
            "text": "酒精发酵",
            "id": "alcohol",
            "children": [
              {
                "line": 26,
                "text": "$\\ce{C6H12O6 ->[酶] 2C2H5OH + 2CO2 + 能量}$"
              },
              {
                "line": 27,
                "text": "酵母菌、大多数植物"
              }
            ]
          },
          {
            "line": 28,
            "text": "乳酸发酵",
            "id": "lactic",
            "children": [
              {
                "line": 29,
                "text": "$\\ce{C6H12O6 ->[酶] 2C3H6O3 + 能量}$"
              },
              {
                "line": 30,
                "text": "乳酸菌、人和动物骨骼肌、马铃薯块茎、甜菜块根"
              }
            ]
          }
        ]
      },
      {
        "line": 31,
        "text": "两者对比",
        "id": "compare",
        "fold": true,
        "children": [
          {
            "line": 32,
            "text": "不同点",
            "children": [
              {
                "line": 33,
                "text": "场所：细胞质基质 + 线粒体 / 只在细胞质基质"
              },
              {
                "line": 34,
                "text": "条件：需 $\\ce{O2}$ / 不需 $\\ce{O2}$"
              },
              {
                "line": 35,
                "text": "分解程度：彻底 / 不彻底"
              },
              {
                "line": 36,
                "text": "能量：大量 / 少量"
              }
            ]
          },
          {
            "line": 37,
            "text": "相同点",
            "children": [
              {
                "line": 38,
                "text": "第一阶段完全相同"
              },
              {
                "line": 39,
                "text": "本质：分解有机物、释放能量"
              }
            ]
          },
          {
            "line": 40,
            "text": "判断呼吸方式",
            "color": "orange",
            "children": [
              {
                "line": 41,
                "text": "只产 $\\ce{CO2}$ 和 $\\ce{H2O}$：有氧"
              },
              {
                "line": 42,
                "text": "产 $\\ce{CO2}$ 多于消耗 $\\ce{O2}$：两者并存"
              },
              {
                "line": 43,
                "text": "不产 $\\ce{CO2}$：乳酸发酵"
              }
            ]
          }
        ]
      },
      {
        "line": 44,
        "text": "影响因素",
        "id": "factors",
        "children": [
          {
            "line": 45,
            "text": "温度：影响酶活性",
            "children": [
              {
                "line": 46,
                "text": "应用：低温储存果蔬"
              }
            ]
          },
          {
            "line": 47,
            "text": "$\\ce{O2}$ 浓度",
            "color": "red",
            "children": [
              {
                "line": 48,
                "text": "抑制无氧呼吸，促进有氧呼吸"
              },
              {
                "line": 49,
                "text": "低氧储存：$\\ce{CO2}$ 释放量最少点"
              }
            ]
          },
          {
            "line": 50,
            "text": "$\\ce{CO2}$ 浓度：浓度高抑制呼吸"
          },
          {
            "line": 51,
            "text": "水分：自由水多呼吸强",
            "children": [
              {
                "line": 52,
                "text": "种子晒干储存"
              }
            ]
          }
        ]
      },
      {
        "line": 53,
        "text": "应用",
        "fold": true,
        "children": [
          {
            "line": 54,
            "text": "包扎伤口用透气纱布"
          },
          {
            "line": 55,
            "text": "中耕松土促根呼吸"
          },
          {
            "line": 56,
            "text": "酿酒先通气后密封"
          },
          {
            "line": 57,
            "text": "提倡慢跑，避免乳酸积累"
          },
          {
            "line": 58,
            "text": "[[光合作用]]"
          }
        ]
      }
    ]
