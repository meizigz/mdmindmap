{
  "root": {
    "line": 1,
    "text": "细胞呼吸",
    "children": [
      {
        "line": 3,
        "text": "概念",
        "children": [
          {
            "line": 4,
            "text": "有机物在细胞内氧化分解，释放能量，生成 ATP 的过程"
          },
          {
            "line": 5,
            "text": "主要场所：线粒体"
          },
          {
            "line": 6,
            "text": "实质：分解有机物，释放能量"
          }
        ]
      },
      {
        "line": 7,
        "text": "有氧呼吸",
        "id": "aerobic",
        "children": [
          {
            "line": 8,
            "text": "总反应式：$\\ce{C6H12O6 + 6O2 + 6H2O -> 6CO2 + 12H2O}$ + 能量"
          },
          {
            "line": 9,
            "text": "第一阶段：葡萄糖分解为丙酮酸和 $[H]$，场所细胞质基质"
          },
          {
            "line": 10,
            "text": "第二阶段：丙酮酸和水分解为 $\\ce{CO2}$ 和 $[H]$，场所线粒体基质"
          },
          {
            "line": 11,
            "text": "第三阶段：$[H]$ 与 $\\ce{O2}$ 结合生成水，场所线粒体内膜"
          },
          {
            "line": 16,
            "text": "1 mol 葡萄糖彻底氧化释放 2870 kJ，约 1161 kJ 储存在 ATP 中"
          }
        ],
        "summaries": [
          {
            "from": 1,
            "to": 3,
            "node": {
              "line": 12,
              "text": "三个阶段",
              "children": [
                {
                  "line": 13,
                  "text": "释放能量：第三阶段最多"
                },
                {
                  "line": 14,
                  "text": "氧气参与：第三阶段"
                },
                {
                  "line": 15,
                  "text": "水参与：第二阶段；水生成：第三阶段"
                }
              ]
            }
          }
        ]
      },
      {
        "line": 17,
        "text": "无氧呼吸",
        "id": "anaerobic",
        "children": [
          {
            "line": 18,
            "text": "场所：全过程在细胞质基质"
          },
          {
            "line": 19,
            "text": "只在第一阶段释放少量能量"
          },
          {
            "line": 20,
            "text": "酒精发酵",
            "children": [
              {
                "line": 21,
                "text": "$\\ce{C6H12O6 -> 2C2H5OH + 2CO2}$ + 少量能量"
              },
              {
                "line": 22,
                "text": "常见：酵母菌、植物根细胞、水淹的植物"
              }
            ]
          },
          {
            "line": 23,
            "text": "乳酸发酵",
            "children": [
              {
                "line": 24,
                "text": "$\\ce{C6H12O6 -> 2C3H6O3}$ + 少量能量"
              },
              {
                "line": 25,
                "text": "常见：乳酸菌、动物细胞、马铃薯块茎、甜菜块根"
              }
            ]
          },
          {
            "line": 26,
            "text": "易错：无氧呼吸中葡萄糖的能量大部分仍留在酒精或乳酸中",
            "color": "red"
          }
        ]
      },
      {
        "line": 27,
        "text": "有氧呼吸与无氧呼吸对比",
        "id": "compare",
        "children": [
          {
            "line": 28,
            "text": "是否需要氧气：有氧需要，无氧不需要"
          },
          {
            "line": 29,
            "text": "产物：有氧为 $\\ce{CO2}$ 和 $\\ce{H2O}$，无氧为酒精和 $\\ce{CO2}$ 或乳酸"
          },
          {
            "line": 30,
            "text": "能量：有氧释放多，无氧释放少"
          },
          {
            "line": 31,
            "text": "相同点：第一阶段完全相同，都生成丙酮酸"
          },
          {
            "line": 32,
            "text": "易错：判断呼吸方式",
            "color": "red",
            "children": [
              {
                "line": 33,
                "text": "只吸 $\\ce{O2}$ 不放 $\\ce{CO2}$：不可能"
              },
              {
                "line": 34,
                "text": "$\\ce{CO2}$ 释放量等于 $\\ce{O2}$ 吸收量：只进行有氧呼吸"
              },
              {
                "line": 35,
                "text": "$\\ce{CO2}$ 释放量大于 $\\ce{O2}$ 吸收量：两种呼吸同时进行"
              }
            ]
          }
        ]
      },
      {
        "line": 36,
        "text": "影响因素",
        "fold": true,
        "children": [
          {
            "line": 37,
            "text": "温度：通过影响酶活性起作用"
          },
          {
            "line": 38,
            "text": "$\\ce{O2}$ 浓度：低氧时呼吸最弱，利于储存果蔬"
          },
          {
            "line": 39,
            "text": "$\\ce{CO2}$ 浓度：浓度高会抑制呼吸"
          },
          {
            "line": 40,
            "text": "含水量：自由水多，呼吸旺盛"
          },
          {
            "line": 41,
            "text": "应用",
            "children": [
              {
                "line": 42,
                "text": "零上低温、低氧保存水果蔬菜"
              },
              {
                "line": 43,
                "text": "干燥条件保存种子"
              },
              {
                "line": 44,
                "text": "中耕松土，促进根部有氧呼吸"
              }
            ]
          }
        ]
      }
    ]
  },
