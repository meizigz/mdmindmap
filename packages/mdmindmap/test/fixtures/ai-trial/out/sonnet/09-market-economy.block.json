          ]
        },
        {
          "line": 10,
          "text": "分配制度",
          "children": [
            {
              "line": 11,
              "text": "按劳分配为主体，多种分配方式并存"
            },
            {
              "line": 12,
              "text": "按生产要素分配：劳动、资本、土地、技术、管理等"
            },
            {
              "line": 13,
              "text": "原则：效率优先，兼顾公平"
            },
            {
              "line": 14,
              "text": "再分配更加注重公平"
            }
          ]
        },
        {
          "line": 15,
          "text": "市场在资源配置中起决定性作用",
          "id": "market",
          "children": [
            {
              "line": 16,
              "text": "市场调节的优点：灵敏、高效"
            },
            {
              "line": 17,
              "text": "市场调节的缺点：自发性、盲目性、滞后性"
            },
            {
              "line": 18,
              "text": "市场秩序：诚信、规则、公平竞争"
            },
            {
              "line": 19,
              "text": "易错：市场起决定性作用不等于市场万能",
              "color": "red"
            }
          ]
        },
        {
          "line": 20,
          "text": "宏观调控",
