{
  "name": "mdmindmap-vscode",
  "displayName": "MD Mindmap",
  "description": "Render mdmindmap mind maps in VS Code: Markdown preview code blocks and a live side-by-side mind map of the whole file.",
  "version": "0.1.6",
  "private": true,
  "publisher": "meizigz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meizigz/mdmindmap.git"
  },
  "type": "commonjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "mindmap",
    "mind map",
    "思维导图"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdmindmap.openPreview",
        "title": "%command.openPreview%",
        "category": "MD Mindmap",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdmindmap.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdmindmap.openPreview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MD Mindmap",
      "properties": {
        "mdmindmap.layout": {
          "type": "string",
          "enum": [
            "logic",
            "bilateral"
          ],
          "default": "logic",
          "description": "%config.layout%"
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "markdown.previewStyles": [
      "./dist/preview.css"
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies --out ../../"
  },
  "dependencies": {
    "mdmindmap": "0.1.6"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2"
  }
}
